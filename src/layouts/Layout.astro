---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Urbanspire Group is a leading construction and general contracting conglomerate delivering signature architectural, civil, and commercial landmarks.',
  image = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://urbanspire-group.demo');
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title} | Urbanspire Group</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#18355f" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Urbanspire Group`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Urbanspire Group`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-white text-[#60697b] antialiased min-h-screen flex flex-col relative overflow-x-hidden max-w-full">
    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#5ba646] focus:text-white focus:rounded focus:outline-none"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Scroll Back To Top Button / Scroll Down Widget -->
    <a
      href="#main-content"
      class="dwns-c opacity-0 pointer-events-none transition-all duration-300"
      id="back-to-top"
      aria-label="Scroll to top"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </a>
  </body>
</html>

<script>
  // Scroll behavior for sticky navbar and back-to-top button
  const header = document.getElementById('site-header');
  const backToTop = document.getElementById('back-to-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 150) {
      header?.classList.add('banner--stick');
      backToTop?.classList.remove('opacity-0', 'pointer-events-none');
      backToTop?.classList.add('opacity-100', 'pointer-events-auto');
    } else {
      header?.classList.remove('banner--stick');
      backToTop?.classList.add('opacity-0', 'pointer-events-none');
      backToTop?.classList.remove('opacity-100', 'pointer-events-auto');
    }
  }, { passive: true });
</script>
