---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { projects } from '../../data/projects';
import { companies } from '../../data/companies';
import type { Project } from '../../types';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const executingCompany = companies.find((c) => c.id === project.companyId);
---

<Layout
  title={`${project.title} | Case Study`}
  description={project.summary}
  image={project.heroImage}
>
  <!-- Page Banner with project image background -->
  <PageBanner
    title={project.title}
    subtitle={project.summary}
    breadcrumb={project.title}
    parentBreadcrumb="Projects"
    parentHref="/projects"
    bgImage={project.heroImage}
  >
    <div class="flex flex-wrap items-center gap-4 text-xs text-white/80 border-t border-white/20 pt-5 mt-2">
      <span class="inline-block bg-[#5ba646] text-white text-xs uppercase font-semibold tracking-wider px-3 py-1 rounded-full">
        {project.sector} • Completed {project.year}
      </span>
      <div class="h-4 w-px bg-white/20 hidden sm:block"></div>
      <div>
        <span class="text-[#aab0bc] uppercase mr-1">Location:</span>
        <span class="font-medium text-white">{project.location}</span>
      </div>
      <div class="h-4 w-px bg-white/20 hidden sm:block"></div>
      <div>
        <span class="text-[#aab0bc] uppercase mr-1">Executing Subsidiary:</span>
        <span class="font-medium text-[#5ba646]">{project.companyName}</span>
      </div>
    </div>
  </PageBanner>

  <!-- Project Case Study Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Case Study Details -->
        <div class="lg:col-span-8">
          <div class="mb-10">
            <h2 class="sb-ttls text-2xl sm:text-3xl mb-4">
              Project Overview & Engineering Scope
            </h2>
            <p class="text-base text-[#60697b] leading-relaxed">
              {project.description}
            </p>
          </div>

          <!-- Project Gallery -->
          {project.gallery && project.gallery.length > 0 && (
            <div class="mt-12">
              <h3 class="text-xl font-bold text-[#18355f] mb-6">
                Construction & Architectural Views
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {project.gallery.map((imgUrl, idx) => (
                  <div class="rounded-lg overflow-hidden border border-[#e4e7eb] h-64 shadow-sm group">
                    <img
                      src={imgUrl}
                      alt={`${project.title} view ${idx + 1}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Navigation Back Links -->
          <div class="mt-12 pt-8 border-t border-[#e2e4e8] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 text-xs uppercase font-semibold tracking-wider text-[#18355f] hover:text-[#5ba646] transition-colors"
            >
              <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <span>Back to All Projects</span>
            </a>

            <a
              href="/contact"
              class="px-6 py-2.5 bg-[#5ba646] hover:bg-[#18355f] text-white text-xs uppercase font-semibold tracking-wider rounded-full transition-colors text-center w-full sm:w-auto"
            >
              Inquire on Similar Project
            </a>
          </div>
        </div>

        <!-- Right: Technical Specification Sidebar -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Technical Metrics Card -->
          {project.stats && project.stats.length > 0 && (
            <div class="bg-[#f6f7f9] border border-[#e2e4e8] rounded-lg p-6">
              <h4 class="text-xs uppercase font-bold text-[#18355f] tracking-wider mb-6 pb-2 border-b border-[#e2e4e8]">
                Engineering Metrics
              </h4>
              <div class="space-y-6 divide-y divide-[#e2e4e8]">
                {project.stats.map((stat, idx) => (
                  <div class={idx !== 0 ? 'pt-4' : ''}>
                    <span class="block font-bold text-2xl text-[#5ba646]">
                      {stat.value}
                    </span>
                    <span class="text-xs uppercase text-[#343f52] font-medium tracking-wide">
                      {stat.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Executing Subsidiary Box -->
          {executingCompany && (
            <div class="bg-white border border-[#e2e4e8] rounded-lg p-6 shadow-sm">
              <span class="text-xs uppercase font-semibold text-[#5ba646] tracking-wider block mb-1">
                Executing Subsidiary
              </span>
              <h4 class="font-bold text-lg text-[#18355f] mb-2">
                {executingCompany.name}
              </h4>
              <p class="text-xs text-[#60697b] mb-4 leading-relaxed">
                {executingCompany.shortSummary}
              </p>
              <a
                href={`/companies/${executingCompany.slug}`}
                class="text-xs uppercase font-semibold text-[#18355f] hover:text-[#5ba646] transition-colors inline-flex items-center gap-1"
              >
                <span>View Company Profile</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          )}

        </div>

      </div>
    </div>
  </section>
</Layout>
