---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
---

<Layout
  title="Contact Headquarters | Urbanspire Group"
  description="Connect with Urbanspire Group executive management or direct tenders to our civil, general contracting, and fit-out subsidiaries."
>
  <!-- Page Banner -->
  <PageBanner
    title="Connect with Urbanspire Group"
    subtitle="Submit project tender invitations, pre-construction feasibility inquiries, or corporate queries directly to our engineering management team."
    breadcrumb="Contact Us"
  />

  <!-- Contact & Tenders Section -->
  <section class="py-16 md:py-24 bg-[#f6f7f9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Inquiry Form -->
        <div class="lg:col-span-7 bg-white border border-[#e4e7eb] rounded-lg p-8 sm:p-10 shadow-sm">
          <div class="mb-8">
            <h2 class="sb-ttls text-2xl mb-2">
              Submit an Inquiry or Tender
            </h2>
            <p class="text-xs sm:text-sm text-[#60697b]">
              Complete the form below and our technical estimating team will respond within 24 business hours.
            </p>
          </div>

          <form id="contact-form" class="space-y-6">
            <!-- Name & Company -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-[#343f52] mb-2">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alexander Vance"
                  class="w-full bg-[#f6f7f9] border border-[#dcdfe5] focus:border-[#5ba646] rounded px-4 py-3 text-sm text-[#343f52] focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="organization" class="block text-xs font-semibold uppercase tracking-wider text-[#343f52] mb-2">
                  Organization / Developer *
                </label>
                <input
                  type="text"
                  id="organization"
                  name="organization"
                  required
                  placeholder="e.g. Apex Real Estate Holdings"
                  class="w-full bg-[#f6f7f9] border border-[#dcdfe5] focus:border-[#5ba646] rounded px-4 py-3 text-sm text-[#343f52] focus:outline-none transition-colors"
                />
              </div>
            </div>

            <!-- Email & Subsidiary Target -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#343f52] mb-2">
                  Corporate Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="e.g. alexander@apexholdings.demo"
                  class="w-full bg-[#f6f7f9] border border-[#dcdfe5] focus:border-[#5ba646] rounded px-4 py-3 text-sm text-[#343f52] focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="department" class="block text-xs font-semibold uppercase tracking-wider text-[#343f52] mb-2">
                  Target Subsidiary *
                </label>
                <select
                  id="department"
                  name="department"
                  required
                  class="w-full bg-[#f6f7f9] border border-[#dcdfe5] focus:border-[#5ba646] rounded px-4 py-3 text-sm text-[#343f52] focus:outline-none transition-colors"
                >
                  <option value="group">Urbanspire Group Corporate</option>
                  <option value="pune">Urbanspire Construction Pvt Ltd, Pune</option>
                  <option value="mumbai">Urbanspire Marine Pvt Ltd, Mumbai</option>
                  <option value="dubai">Urbanspire Global Service, Dubai</option>
                </select>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-[#343f52] mb-2">
                Project Scope & Details *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Outline project location, anticipated floor area, structural complexity, and target start dates..."
                class="w-full bg-[#f6f7f9] border border-[#dcdfe5] focus:border-[#5ba646] rounded px-4 py-3 text-sm text-[#343f52] focus:outline-none transition-colors"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div>
              <button
                type="submit"
                id="submit-btn"
                class="inline-flex items-center justify-center px-8 py-3 text-xs font-semibold uppercase tracking-wider text-white bg-[#5ba646] hover:bg-[#18355f] rounded-full transition-colors"
              >
                <span>Transmit Inquiry</span>
                <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>

            <!-- Feedback Container -->
            <div id="form-feedback" class="hidden p-4 rounded text-xs"></div>
          </form>
        </div>

        <!-- Right: Corporate Coordinates -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white border border-[#e4e7eb] rounded-lg p-6 shadow-sm">
            <span class="text-xs uppercase font-bold text-[#5ba646] tracking-wider block mb-1">
              Headquarters
            </span>
            <h3 class="font-bold text-xl text-[#18355f] mb-3">
              Urbanspire Tower
            </h3>
            <p class="text-sm text-[#60697b] leading-relaxed mb-4">
              Level 42, Financial Center Boulevard<br />
              Commercial Business District
            </p>
            <div class="space-y-2.5 text-xs text-[#343f52] pt-4 border-t border-[#e2e4e8]">
              <div class="flex items-center justify-between">
                <span class="text-[#959ca9]">General:</span>
                <span class="font-medium">info@urbanspire-group.demo</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#959ca9]">Tenders:</span>
                <span class="font-semibold text-[#5ba646]">tenders@urbanspire-group.demo</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#959ca9]">Working Hours:</span>
                <span>Mon – Fri (08:00 – 18:00)</span>
              </div>
            </div>

            <!-- Regional Operating Entities -->
            <div class="pt-5 mt-5 border-t border-[#e2e4e8] space-y-4">
              <div>
                <span class="text-[10px] uppercase font-bold text-[#5ba646] tracking-wider block">
                  Pune Office — Construction
                </span>
                <span class="font-semibold text-xs text-[#18355f] block">
                  Urbanspire Construction Pvt Ltd
                </span>
                <span class="text-[11px] text-[#60697b] block">Pune Commercial Precinct, Maharashtra, India</span>
                <span class="text-[11px] text-[#5ba646]">construction.pune@urbanspire-group.demo</span>
              </div>
              <div>
                <span class="text-[10px] uppercase font-bold text-[#5ba646] tracking-wider block">
                  Mumbai Office — Marine & Maritime
                </span>
                <span class="font-semibold text-xs text-[#18355f] block">
                  Urbanspire Marine Pvt Ltd
                </span>
                <span class="text-[11px] text-[#60697b] block">Nariman Point / BKC Coastal Center, Mumbai, India</span>
                <span class="text-[11px] text-[#5ba646]">marine.mumbai@urbanspire-group.demo</span>
              </div>
              <div>
                <span class="text-[10px] uppercase font-bold text-[#5ba646] tracking-wider block">
                  Dubai Office — Global Services
                </span>
                <span class="font-semibold text-xs text-[#18355f] block">
                  Urbanspire Global Service
                </span>
                <span class="text-[11px] text-[#60697b] block">Business Bay / DIFC, Dubai, UAE</span>
                <span class="text-[11px] text-[#5ba646]">global.dubai@urbanspire-group.demo</span>
              </div>
            </div>
          </div>

          <!-- Pre-Qualification Deck Download -->
          <div class="bg-[#18355f] text-white rounded-lg p-6">
            <h4 class="text-white text-base font-bold mb-2">
              Pre-Qualification Package
            </h4>
            <p class="text-xs text-white/80 mb-4 leading-relaxed">
              Download our audited group track record, ISO certifications, and heavy plant fleet schedule.
            </p>
            <a
              href="/Urbanspire-Group-Profile.pdf"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs uppercase font-semibold text-[#5ba646] hover:text-white transition-colors"
            >
              <span>Download Pre-Qual Package (PDF)</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  if (form && feedback && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = 'Transmitting...';

      setTimeout(() => {
        feedback.classList.remove('hidden');
        feedback.className = 'p-4 rounded text-xs bg-emerald-50 border border-emerald-200 text-emerald-800';
        feedback.innerHTML = '<strong>Inquiry Transmitted:</strong> Thank you for contacting Urbanspire Group. Your inquiry has been routed to our technical estimating division.';
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = '<span>Transmit Inquiry</span><svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>';
      }, 700);
    });
  }
</script>
