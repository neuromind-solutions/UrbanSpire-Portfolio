---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import { jobOpenings, careerPillars } from '../data/careers';
---

<Layout
  title="Careers & Opportunities | Urbanspire Group"
  description="Explore career opportunities across civil high-rise, marine engineering, and BIM digital solutions with Urbanspire Group in Pune, Mumbai, and Dubai."
>
  <PageBanner
    title="Careers at Urbanspire"
    subtitle="Build landmark infrastructure with us. Explore exciting opportunities across our operating companies in Pune, Mumbai, and Dubai."
    breadcrumb="Careers"
  />

  <!-- Why Work With Us Section (4 Pillars) -->
  <section class="py-16 md:py-24 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h4 class="tp-ttls inline-block">
          <span>Life at Urbanspire</span>
        </h4>
        <h2 class="sb-ttls text-3xl sm:text-4xl mt-2 mb-4 text-[#18355f]">
          Why Build Your Career With Us
        </h2>
        <p class="text-base text-[#60697b] leading-relaxed">
          At Urbanspire, our people are our cornerstone. We cultivate an inclusive, safety-first environment that encourages engineering curiosity, professional leadership, and regional impact.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {careerPillars.map((pillar) => (
          <div class="p-8 rounded-xl bg-[#f8f9fa] border border-[#e4e7eb] hover:border-[#5ba646] hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="w-14 h-14 rounded-lg bg-[#18355f] group-hover:bg-[#5ba646] flex items-center justify-center mb-6 transition-colors shadow-sm">
                {pillar.icon === 'building' && (
                  <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {pillar.icon === 'shield' && (
                  <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {pillar.icon === 'globe' && (
                  <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {pillar.icon === 'cpu' && (
                  <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                )}
              </div>
              <h3 class="text-lg font-bold text-[#18355f] mb-2">{pillar.title}</h3>
              <p class="text-sm text-[#60697b] leading-relaxed">{pillar.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Open Positions Section -->
  <section class="py-16 md:py-24 bg-[#fbfbfc]" id="openings">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
        <div>
          <h4 class="tp-ttls mb-2">
            <span>Current Openings</span>
          </h4>
          <h2 class="sb-ttls text-3xl sm:text-4xl text-[#18355f]">
            Find Your Next Challenge
          </h2>
          <p class="text-sm text-[#60697b] mt-2">
            Showing opportunities across our three regional operating entities.
          </p>
        </div>

        <!-- Filter Buttons -->
        <div class="flex flex-wrap items-center gap-2" id="filter-container">
          <button
            type="button"
            class="filter-tab-btn active px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-[#18355f] text-white"
            data-filter="all"
          >
            All Roles ({jobOpenings.length})
          </button>
          <button
            type="button"
            class="filter-tab-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-white text-[#343f52] border border-gray-200 hover:border-[#5ba646]"
            data-filter="urbanspire-construction-pune"
          >
            Pune (Construction)
          </button>
          <button
            type="button"
            class="filter-tab-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-white text-[#343f52] border border-gray-200 hover:border-[#5ba646]"
            data-filter="urbanspire-marine-mumbai"
          >
            Mumbai (Marine)
          </button>
          <button
            type="button"
            class="filter-tab-btn px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-white text-[#343f52] border border-gray-200 hover:border-[#5ba646]"
            data-filter="urbanspire-global-service-dubai"
          >
            Dubai (Global Service)
          </button>
        </div>
      </div>

      <!-- Job Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="job-cards-list">
        {jobOpenings.map((job) => (
          <div
            class="job-card bg-white rounded-xl p-7 border border-[#e4e7eb] hover:border-[#5ba646] hover:shadow-md transition-all duration-300 flex flex-col justify-between"
            data-company={job.companySlug}
          >
            <div>
              <!-- Header Badges -->
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-[#18355f]/10 text-[#18355f]">
                  {job.companyName}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-[#5ba646]/15 text-[#3b7e28]">
                  {job.type}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold text-[#18355f] mb-3 group-hover:text-[#5ba646] transition-colors">
                {job.title}
              </h3>

              <!-- Meta Info -->
              <div class="flex flex-wrap items-center gap-y-2 gap-x-5 text-xs text-[#60697b] mb-4 pb-4 border-b border-gray-100">
                <span class="flex items-center gap-1.5 font-medium">
                  <svg class="w-4 h-4 text-[#5ba646]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {job.location}
                </span>
                <span class="flex items-center gap-1.5 font-medium">
                  <svg class="w-4 h-4 text-[#5ba646]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  {job.department}
                </span>
                <span class="flex items-center gap-1.5 font-medium">
                  <svg class="w-4 h-4 text-[#5ba646]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {job.experience}
                </span>
              </div>

              <!-- Description -->
              <p class="text-sm text-[#60697b] leading-relaxed mb-5">
                {job.description}
              </p>

              <!-- Skill Pills -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {job.keySkills.map((skill) => (
                  <span class="px-2.5 py-1 bg-gray-100 text-gray-700 text-[11px] font-medium rounded-md">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
              <a
                href={`/companies/${job.companySlug}`}
                class="text-xs font-semibold text-[#18355f] hover:text-[#5ba646] uppercase tracking-wider transition-colors inline-flex items-center gap-1"
              >
                <span>About Company</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <button
                type="button"
                class="apply-role-btn px-4 py-2 bg-[#5ba646] hover:bg-[#18355f] text-white text-xs font-semibold uppercase tracking-wider rounded-full transition-colors inline-flex items-center gap-1.5 shadow-sm"
                data-role={job.title}
                data-company={job.companyName}
              >
                <span>Apply Now</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Application / Talent Drop Section -->
  <section class="py-16 md:py-24 bg-white" id="apply-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Narrative & Hiring Process -->
        <div class="lg:col-span-5">
          <h4 class="tp-ttls mb-3">
            <span>Direct Application</span>
          </h4>
          <h2 class="sb-ttls text-3xl sm:text-4xl text-[#18355f] mb-5">
            Join the Urbanspire Team
          </h2>
          <p class="text-base text-[#60697b] leading-relaxed mb-8">
            Don't see an exact match for your specialty? We are constantly seeking talented civil engineers, marine specialists, cost estimators, BIM modellers, and commercial directors across India and the UAE.
          </p>

          <!-- 4 Step Process -->
          <div class="space-y-6 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#18355f] text-white text-xs font-bold flex items-center justify-center shrink-0">1</div>
              <div>
                <h4 class="text-sm font-bold text-[#18355f]">CV & Portfolio Review</h4>
                <p class="text-xs text-[#60697b] mt-0.5">Our technical talent acquisition team assesses your project experience.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#18355f] text-white text-xs font-bold flex items-center justify-center shrink-0">2</div>
              <div>
                <h4 class="text-sm font-bold text-[#18355f]">Technical Discussion</h4>
                <p class="text-xs text-[#60697b] mt-0.5">In-depth interview with the engineering department lead or project director.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#18355f] text-white text-xs font-bold flex items-center justify-center shrink-0">3</div>
              <div>
                <h4 class="text-sm font-bold text-[#18355f]">Leadership Panel</h4>
                <p class="text-xs text-[#60697b] mt-0.5">Alignment on cultural values, QHSE safety commitment, and career expectations.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-[#5ba646] text-white text-xs font-bold flex items-center justify-center shrink-0">4</div>
              <div>
                <h4 class="text-sm font-bold text-[#18355f]">Offer & Integration</h4>
                <p class="text-xs text-[#60697b] mt-0.5">Formal onboarding into our Pune, Mumbai, or Dubai headquarters.</p>
              </div>
            </div>
          </div>

          <!-- HR Contact Card -->
          <div class="p-6 rounded-xl bg-[#f8f9fa] border border-[#e4e7eb]">
            <span class="block text-xs uppercase tracking-wider text-[#959ca9] font-semibold mb-1">Human Resources & Recruitment</span>
            <a href="mailto:careers@urbanspire-group.demo" class="text-base font-bold text-[#18355f] hover:text-[#5ba646] transition-colors">
              careers@urbanspire-group.demo
            </a>
            <p class="text-xs text-[#60697b] mt-2">
              Urbanspire Group is an equal opportunity employer committed to safety, diversity, and merit-based advancement.
            </p>
          </div>
        </div>

        <!-- Right: Interactive Application Form -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-2xl bg-white border border-[#e4e7eb] shadow-xl">
            <h3 class="text-2xl font-bold text-[#18355f] mb-2" id="form-heading">
              Submit Your Candidacy
            </h3>
            <p class="text-xs text-[#60697b] mb-8">
              Fields marked with an asterisk (<span class="text-red-500">*</span>) are required.
            </p>

            <form id="careers-application-form" class="space-y-6">
              
              <!-- Name & Email Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="applicant-name" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                    Full Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="applicant-name"
                    name="name"
                    required
                    placeholder="e.g. Rahul Sharma"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52]"
                  />
                </div>
                <div>
                  <label for="applicant-email" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="applicant-email"
                    name="email"
                    required
                    placeholder="e.g. rahul.sharma@example.com"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52]"
                  />
                </div>
              </div>

              <!-- Phone & Location / Operating Entity Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="applicant-phone" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                    Phone Number <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="applicant-phone"
                    name="phone"
                    required
                    placeholder="e.g. +91 98765 43210"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52]"
                  />
                </div>
                <div>
                  <label for="applicant-company" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                    Preferred Operating Company <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="applicant-company"
                    name="company"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52] bg-white"
                  >
                    <option value="" disabled selected>Select operating company</option>
                    <option value="Urbanspire Construction Pvt Ltd, Pune">Urbanspire Construction Pvt Ltd (Pune)</option>
                    <option value="Urbanspire Marine Pvt Ltd, Mumbai">Urbanspire Marine Pvt Ltd (Mumbai)</option>
                    <option value="Urbanspire Global Service, Dubai">Urbanspire Global Service (Dubai)</option>
                    <option value="Open to Any Location / Entity">Open to Any Location / Entity</option>
                  </select>
                </div>
              </div>

              <!-- Target Position -->
              <div>
                <label for="applicant-role" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                  Role of Interest <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="applicant-role"
                  name="role"
                  required
                  placeholder="e.g. Senior Project Manager, Structural Engineer, BIM Lead..."
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52]"
                />
              </div>

              <!-- Resume File Input -->
              <div>
                <label class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                  Upload Resume / CV (PDF or DOCX, max 10MB) <span class="text-red-500">*</span>
                </label>
                <div class="relative border-2 border-dashed border-gray-300 rounded-lg p-5 hover:border-[#5ba646] transition-colors text-center cursor-pointer bg-gray-50/50">
                  <input
                    type="file"
                    id="applicant-resume"
                    name="resume"
                    accept=".pdf,.doc,.docx"
                    required
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  />
                  <div class="flex flex-col items-center justify-center">
                    <svg class="w-8 h-8 text-gray-400 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    <span class="text-xs font-semibold text-[#18355f]" id="file-label-text">
                      Click to choose or drag & drop your CV
                    </span>
                    <span class="text-[11px] text-gray-400 mt-1">PDF, DOC, DOCX up to 10MB</span>
                  </div>
                </div>
              </div>

              <!-- Message / Cover Note -->
              <div>
                <label for="applicant-note" class="block text-xs font-bold text-[#18355f] uppercase tracking-wider mb-2">
                  Cover Note / Portfolio Summary
                </label>
                <textarea
                  id="applicant-note"
                  name="note"
                  rows="3"
                  placeholder="Share a brief overview of your landmark projects or engineering expertise..."
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#5ba646] focus:ring-2 focus:ring-[#5ba646]/20 outline-none text-sm transition-all text-[#343f52] resize-y"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div>
                <button
                  type="submit"
                  id="submit-app-btn"
                  class="w-full py-3.5 px-6 rounded-full bg-[#5ba646] hover:bg-[#18355f] text-white font-semibold text-xs uppercase tracking-wider transition-all duration-300 shadow-md flex items-center justify-center gap-2"
                >
                  <span>Submit Application</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>

              <!-- Client Confirmation Message Box -->
              <div id="form-success-alert" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
                <div class="flex items-center gap-2 font-bold mb-1">
                  <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Application Submitted Successfully
                </div>
                <p class="text-xs text-green-700">
                  Thank you for your interest in joining Urbanspire Group. Our Talent Acquisition team will review your profile and reach out within 3–5 business days.
                </p>
              </div>

            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Client-side Interactive Script -->
  <script>
    // 1. Company Filter Tabs
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-tab-btn');
    const jobCards = document.querySelectorAll<HTMLElement>('.job-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Active button styles
        filterBtns.forEach((b) => {
          b.classList.remove('bg-[#18355f]', 'text-white');
          b.classList.add('bg-white', 'text-[#343f52]', 'border-gray-200');
        });
        btn.classList.add('bg-[#18355f]', 'text-white');
        btn.classList.remove('bg-white', 'text-[#343f52]', 'border-gray-200');

        const filter = btn.dataset.filter;

        jobCards.forEach((card) => {
          if (filter === 'all' || card.dataset.company === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. "Apply Now" Card Button triggers auto-fill and smooth scroll
    const applyBtns = document.querySelectorAll<HTMLButtonElement>('.apply-role-btn');
    const roleInput = document.getElementById('applicant-role') as HTMLInputElement | null;
    const companySelect = document.getElementById('applicant-company') as HTMLSelectElement | null;
    const formHeading = document.getElementById('form-heading');
    const applySection = document.getElementById('apply-section');

    applyBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const role = btn.dataset.role || '';
        const company = btn.dataset.company || '';

        if (roleInput) roleInput.value = role;
        
        if (companySelect) {
          // Select corresponding option if match found
          for (let i = 0; i < companySelect.options.length; i++) {
            if (companySelect.options[i].text.toLowerCase().includes(company.toLowerCase().slice(0, 15))) {
              companySelect.selectedIndex = i;
              break;
            }
          }
        }

        if (formHeading) {
          formHeading.textContent = `Applying for: ${role}`;
        }

        applySection?.scrollIntoView({ behavior: 'smooth' });
        roleInput?.focus();
      });
    });

    // 3. File Input Label update
    const fileInput = document.getElementById('applicant-resume') as HTMLInputElement | null;
    const fileLabel = document.getElementById('file-label-text');

    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        if (fileLabel) fileLabel.textContent = `Selected: ${fileInput.files[0].name}`;
      }
    });

    // 4. Form Submit Simulation
    const appForm = document.getElementById('careers-application-form') as HTMLFormElement | null;
    const successAlert = document.getElementById('form-success-alert');
    const submitBtn = document.getElementById('submit-app-btn');

    appForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Submitting...</span>`;
        submitBtn.setAttribute('disabled', 'true');
      }

      setTimeout(() => {
        if (successAlert) successAlert.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.innerHTML = `<span>Application Submitted ✓</span>`;
          submitBtn.classList.remove('bg-[#5ba646]');
          submitBtn.classList.add('bg-[#18355f]');
        }
        appForm.reset();
        if (fileLabel) fileLabel.textContent = 'Click to choose or drag & drop your CV';
      }, 700);
    });
  </script>

</Layout>
