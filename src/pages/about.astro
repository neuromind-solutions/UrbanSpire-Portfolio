---
import Layout from '../layouts/Layout.astro';
import PillarsSection from '../components/PillarsSection.astro';
import CompanyCard from '../components/CompanyCard.astro';
import PageBanner from '../components/PageBanner.astro';
import { companies } from '../data/companies';
---

<Layout
  title="About the Group | Vision, Structure & Governance"
  description="Learn about Urbanspire Group's architectural heritage, unified group structure, executive governance, and QHSE commitments."
>
  <!-- Page Banner -->
  <PageBanner
    title="About Urbanspire Group"
    subtitle="An integrated construction and general contracting conglomerate structured to manage complex capital developments from foundation piling to luxury fit-outs."
    breadcrumb="About Us"
  />

  <!-- Group Philosophy & Heritage Section -->
  <section class="py-16 md:py-24 bg-white" id="heritage">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6">
          <h4 class="tp-ttls">
            <span>Heritage & Ethos</span>
          </h4>
          <h2 class="sb-ttls mb-6">
            A legacy of master engineering and measured growth
          </h2>
          <div class="space-y-4 text-sm sm:text-base text-[#60697b] leading-relaxed">
            <p>
              Urbanspire Group unites three specialized operating companies that handle every tier of the built environment. Instead of relying on disconnected sub-contractors, our group structure ensures seamless coordination between civil engineers, project managers, and interior craftspeople.
            </p>
            <p>
              From deep marine foundation walls and high-rise structural concrete cores to smart building management systems and bespoke acoustic interiors, our integrated workflow guarantees schedule predictability, unified accountability, and benchmark build quality.
            </p>
          </div>

          <!-- Certifications Strip -->
          <div class="mt-8 pt-6 border-t border-[#e2e4e8] grid grid-cols-3 gap-4" id="standards">
            <div>
              <span class="block font-bold text-2xl text-[#18355f]">ISO 9001</span>
              <span class="text-xs uppercase text-[#959ca9] font-medium">Quality Certified</span>
            </div>
            <div>
              <span class="block font-bold text-2xl text-[#5ba646]">ISO 45001</span>
              <span class="text-xs uppercase text-[#959ca9] font-medium">Occupational Health</span>
            </div>
            <div>
              <span class="block font-bold text-2xl text-[#18355f]">ISO 14001</span>
              <span class="text-xs uppercase text-[#959ca9] font-medium">Environmental Mgmt</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-lg overflow-hidden shadow-lg border border-[#e4e7eb]">
            <img
              src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80"
              alt="Structural engineering construction by Urbanspire Group"
              class="w-full h-[400px] object-cover"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- The Three Operating Companies Section -->
  <section class="py-16 md:py-24 bg-[#f6f7f9] border-t border-[#e2e4e8]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h4 class="tp-ttls lns-c">
          <span>Corporate Structure</span>
        </h4>
        <h2 class="sb-ttls">
          The Three Operating Entities
        </h2>
        <p class="text-sm text-[#60697b] max-w-2xl mt-2">
          The parent group provides centralized strategic governance, digital BIM standards, and procurement scale, while our three operating companies maintain dedicated technical workforces.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {companies.map((company) => (
          <CompanyCard company={company} />
        ))}
      </div>
    </div>
  </section>

  <!-- Sustainability Section -->
  <div id="sustainability">
    <PillarsSection />
  </div>
</Layout>
