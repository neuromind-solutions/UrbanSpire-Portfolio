---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | Urbanspire Group"
  description="The requested architectural blueprint or resource could not be located on our servers."
>
  <section class="min-h-[75vh] flex items-center justify-center py-24 px-4 bg-white text-center">
    <div class="max-w-md mx-auto">
      <div class="w-16 h-16 rounded-full bg-[#f6f7f9] border border-[#e2e4e8] text-[#5ba646] mx-auto flex items-center justify-center font-bold text-2xl mb-6">
        <span>404</span>
      </div>

      <h1 class="text-3xl font-bold text-[#18355f] mb-3">
        Page Not Found
      </h1>
      <p class="text-sm text-[#60697b] leading-relaxed mb-8">
        The coordinate or page you requested does not exist in our corporate directory or has been relocated.
      </p>

      <div class="flex items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-[#5ba646] hover:bg-[#18355f] rounded-full transition-colors"
        >
          Return Home
        </a>
        <a
          href="/projects"
          class="px-6 py-2.5 text-xs font-semibold uppercase tracking-wider text-[#18355f] bg-[#f6f7f9] hover:bg-[#e4e7eb] rounded-full transition-colors"
        >
          Browse Projects
        </a>
      </div>
    </div>
  </section>
</Layout>
