---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb: string;
  breadcrumbHref?: string;
  parentBreadcrumb?: string;
  parentHref?: string;
  bgImage?: string;
}

const { 
  title, 
  subtitle, 
  breadcrumb, 
  breadcrumbHref, 
  parentBreadcrumb, 
  parentHref, 
  bgImage 
} = Astro.props;
---

<!-- Page Banner — matches ASGC pg-banner structure: navy bg, tall, breadcrumbs, h1 -->
<section class="page-banner-section relative overflow-hidden">
  <!-- Background image if supplied (with overlay) -->
  {bgImage && (
    <div class="absolute inset-0 z-0">
      <img src={bgImage} alt="" aria-hidden="true" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-[#18355f]/85"></div>
    </div>
  )}

  <!-- Navy solid background when no image -->
  {!bgImage && (
    <div class="absolute inset-0 bg-[#18355f] z-0"></div>
  )}

  <!-- Subtle texture overlay -->
  <div class="absolute inset-0 z-0 opacity-10"
    style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0, rgba(255,255,255,0.03) 1px, transparent 0, transparent 50%); background-size: 24px 24px;">
  </div>

  <!-- Green accent line at bottom -->
  <div class="absolute bottom-0 left-0 w-full h-[3px] bg-[#5ba646] z-10"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-4xl">
      <!-- Breadcrumb nav -->
      <nav class="flex items-center space-x-2 text-xs uppercase tracking-wider text-white/60 mb-5 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#5ba646] transition-colors">Home</a>
        <span class="text-white/40">/</span>
        
        {parentBreadcrumb && parentHref ? (
          <>
            <a href={parentHref} class="hover:text-[#5ba646] transition-colors">{parentBreadcrumb}</a>
            <span class="text-white/40">/</span>
          </>
        ) : null}

        {breadcrumbHref && !parentBreadcrumb ? (
          <a href={breadcrumbHref} class="hover:text-[#5ba646] transition-colors">{breadcrumb}</a>
        ) : (
          <span class="text-[#5ba646] line-clamp-1">{breadcrumb}</span>
        )}
      </nav>

      <!-- Page Heading -->
      <h1 class="text-4xl sm:text-5xl lg:text-[52px] font-normal text-white leading-tight mb-5">
        {title}
      </h1>

      <!-- Optional Subtitle -->
      {subtitle && (
        <p class="text-base sm:text-lg text-white/75 font-light leading-relaxed max-w-2xl mb-6">
          {subtitle}
        </p>
      )}

      <!-- Optional Child Elements / Slot -->
      <slot />
    </div>
  </div>
</section>
