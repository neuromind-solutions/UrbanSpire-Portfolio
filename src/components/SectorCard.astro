---
import type { Sector } from '../types';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;
---

<div class="fncy-bxs-ctg group relative rounded-lg overflow-hidden shadow-md">
  <!-- Sector Photography with Bottom Gradient Overlay & Center Arrow -->
  <figure class="th-ctgr-sc relative w-full h-[280px] sm:h-[320px] md:h-[350px] overflow-hidden m-0 block">
    <img
      src={sector.image}
      alt={sector.title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />

    <!-- Circular Arrow (Kept pointed center of image, reveals on hover) -->
    <div class="sector-arrow" aria-hidden="true">
      <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
    </div>

    <!-- Bottom Texts: Subtitle/Tagline (Green) + Title (Bold White) as shown in Image 2 -->
    <div class="sector-bottom-content absolute bottom-0 left-0 right-0 p-5 sm:p-6 z-10 flex flex-col justify-end pointer-events-none">
      <span class="text-xs font-semibold text-[#5ba646] uppercase tracking-wider mb-1 drop-shadow">
        {sector.tagline}
      </span>
      <h3 class="text-xl sm:text-2xl font-bold text-white tracking-wide leading-tight drop-shadow-md">
        {sector.title}
      </h3>
    </div>
  </figure>

  <!-- Entire Card Link (accessible, zero text overlap) -->
  <a
    class="aslnk-ws absolute inset-0 z-20"
    href={`/projects?sector=${encodeURIComponent(sector.title)}`}
    aria-label={`Explore ${sector.title} projects`}
  >
    <span class="sr-only">Explore {sector.title}</span>
  </a>
</div>
