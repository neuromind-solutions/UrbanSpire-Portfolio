---
const slides = [
  {
    companyTag: 'URBANSPIRE CONSTRUCTION',
    title: 'Building Landmark Infrastructure',
    subtitle: 'Civil infrastructure & high-rise engineering in Pune.',
    companyName: 'Urbanspire Construction, Pune',
    link: '/companies/urbanspire-construction-pune',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-modern-city-skyscrapers-and-buildings-42668-large.mp4',
    poster: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2000&q=85',
  },
  {
    companyTag: 'URBANSPIRE MARINE',
    title: 'Mastering Coastal & Marine Works',
    subtitle: 'Ports, maritime defense, and coastal civil engineering in Mumbai.',
    companyName: 'Urbanspire Marine, Mumbai',
    link: '/companies/urbanspire-marine-mumbai',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-aerial-view-of-waves-crashing-on-a-rocky-coast-41684-large.mp4',
    poster: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=2000&q=85',
  },
  {
    companyTag: 'URBANSPIRE GLOBAL SERVICE',
    title: 'Global Project Excellence & BIM',
    subtitle: 'International consulting and digital smart delivery from Dubai.',
    companyName: 'Urbanspire Global Service, Dubai',
    link: '/companies/urbanspire-global-service-dubai',
    video: 'https://assets.mixkit.co/videos/preview/mixkit-aerial-view-of-city-traffic-at-night-11-large.mp4',
    poster: 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=2000&q=85',
  }
];

const totalSlides = slides.length;
---

<section class="bnrscxs relative overflow-hidden" aria-label="Hero slideshow">
  <div class="hm-crslc-wrapper">
    <div class="hm-crslc-sw relative">
      
      <!-- Video Slides Container -->
      <div class="insblsx relative w-full bg-black" id="hero-container">
        
        {slides.map((slide, idx) => (
          <div
            class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
            data-index={idx}
          >
            <!-- Background Video with poster fallback -->
            <video
              playsinline
              autoplay={idx === 0}
              muted
              loop
              preload={idx === 0 ? 'auto' : 'none'}
              poster={slide.poster}
              class="absolute inset-0 w-full h-full object-cover"
              data-slide-video
            >
              <source src={slide.video} type="video/mp4" />
              <!-- Poster fallback for when video can't play -->
            </video>

            <!-- Poster image fallback (always visible until video plays) -->
            <img
              src={slide.poster}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 w-full h-full object-cover -z-10"
              loading={idx === 0 ? 'eager' : 'lazy'}
            />

            <!-- Gradient Scrim for Legibility -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/35 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/30 z-10 pointer-events-none"></div>

            <!-- Slide Content (left-aligned like ASGC: left 9%, vertically centered) -->
            <div class="cntsc-sld z-20">
              <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[11px] sm:text-xs font-semibold tracking-wider text-[#5ba646] uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-[#5ba646]"></span>
                <span>{slide.companyTag}</span>
              </div>
              <h2 class="text-white font-normal text-3xl sm:text-4xl lg:text-[42px] leading-tight mb-3">
                {slide.title}
              </h2>
              <p class="text-white/90 text-sm sm:text-base font-light leading-relaxed mb-6 max-w-md">
                {slide.subtitle}
              </p>
              <div>
                <a href={slide.link} class="sld-btn">
                  Discover More
                </a>
              </div>
            </div>

          </div>
        ))}

        <!-- Shared Bottom Right: Company Callout & Counter & Arrow -->
        <div class="nmsx z-30 flex items-center" id="hero-bottom-info">
          <div class="lftsx">
            <h3 class="prcnms text-white font-medium text-sm sm:text-base" id="hero-company-name">
              {slides[0].companyName}
            </h3>
          </div>
          <div class="cntrbx">
            <span class="text-white font-bold" id="hero-current-num">1</span>/{totalSlides}
          </div>
          <button
            type="button"
            class="hero-next-btn"
            id="hero-next-btn"
            aria-label="Next Slide"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const slideData = [
    { companyName: 'Urbanspire Construction, Pune', link: '/companies/urbanspire-construction-pune' },
    { companyName: 'Urbanspire Marine, Mumbai', link: '/companies/urbanspire-marine-mumbai' },
    { companyName: 'Urbanspire Global Service, Dubai', link: '/companies/urbanspire-global-service-dubai' },
  ];

  const slideEls = document.querySelectorAll<HTMLElement>('.hero-slide');
  const videoEls = document.querySelectorAll<HTMLVideoElement>('[data-slide-video]');
  const nextBtn = document.getElementById('hero-next-btn');
  const companyNameEl = document.getElementById('hero-company-name');
  const currentNum = document.getElementById('hero-current-num');

  let currentIdx = 0;
  let autoAdvance: ReturnType<typeof setInterval>;

  function goToSlide(index: number) {
    const prev = currentIdx;
    currentIdx = ((index % slideEls.length) + slideEls.length) % slideEls.length;

    // Hide previous
    slideEls[prev].classList.remove('opacity-100', 'z-10');
    slideEls[prev].classList.add('opacity-0', 'z-0', 'pointer-events-none');
    // Pause previous video
    videoEls[prev]?.pause();

    // Show new
    slideEls[currentIdx].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
    slideEls[currentIdx].classList.add('opacity-100', 'z-10');
    // Play new video (load first if not yet loaded)
    const vid = videoEls[currentIdx];
    if (vid) {
      if (vid.readyState < 2) {
        vid.load();
      }
      vid.play().catch(() => {/* autoplay blocked — poster is fallback */});
    }

    // Update UI
    if (companyNameEl) companyNameEl.textContent = slideData[currentIdx].companyName;
    if (currentNum) currentNum.textContent = String(currentIdx + 1);
  }

  function resetAutoAdvance() {
    clearInterval(autoAdvance);
    autoAdvance = setInterval(() => goToSlide(currentIdx + 1), 8000);
  }

  nextBtn?.addEventListener('click', () => {
    goToSlide(currentIdx + 1);
    resetAutoAdvance();
  });

  // Auto-advance
  autoAdvance = setInterval(() => goToSlide(currentIdx + 1), 8000);

  // Reduced motion: disable video autoplay
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    videoEls.forEach(v => { v.pause(); });
    clearInterval(autoAdvance);
  }

  // Play first slide video
  videoEls[0]?.play().catch(() => {/* poster fallback */});
</script>
