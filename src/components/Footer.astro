---
const currentYear = 2026;
---

<footer class="bg-primary ftrs-scs text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Top Row: Key Information & Download Profile -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start pb-8">
      
      <!-- Key Information Title & Navigation Columns -->
      <div class="md:col-span-9">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
          <div class="sm:col-span-4 flex flex-col justify-between pr-4">
            <a href="/" class="inline-block mb-3 group" aria-label="Urbanspire Group Home">
              <img
                src="/images/logo-white.png"
                alt="Urbanspire Group"
                class="h-12 sm:h-14 w-auto object-contain transition-opacity duration-300 opacity-95 group-hover:opacity-100"
                loading="lazy"
              />
            </a>
            <p class="text-xs text-white/70 leading-relaxed max-w-xs mt-1">
              Integrated general contracting conglomerate delivering signature landmarks across civil, marine, and commercial sectors.
            </p>
          </div>
          <div class="sm:col-span-8">
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
              <ul class="list-unstyled mb-0 space-y-2.5">
                <li><a href="/projects">Projects</a></li>
                <li><a href="/companies">Our Companies</a></li>
                <li><a href="/services">Group Services</a></li>
              </ul>
              <ul class="list-unstyled mb-0 space-y-2.5">
                <li><a href="/about">About Us</a></li>
                <li><a href="/about#sustainability">Sustainability</a></li>
                <li><a href="/contact">Tenders</a></li>
              </ul>
              <ul class="list-unstyled mb-0 space-y-2.5 hidden sm:block">
                <li><a href="/about#safety">QHSE & Safety</a></li>
                <li><a href="/services#bim">Technology</a></li>
                <li><a href="/contact">Vendors</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Download Profile CTA (Matching ASGC dwn-bl) -->
      <div class="md:col-span-3 text-left md:text-right">
        <h4>Download Profile</h4>
        <a
          class="dwn-bl bg-secondary mt-2 inline-flex"
          target="_blank"
          href="/Urbanspire-Group-Profile.pdf"
          aria-label="Download Corporate Profile PDF"
        >
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Green Divider Line (Matching ASGC hr.bg-secondary) -->
    <hr class="my-8 border-none h-[1px] bg-[#5ba646]" />

    <!-- Middle Row: Contact Us Link & Follow Us Socials -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8">
        <h2 class="ttl-ft mb-0">
          <a href="/contact" class="hover:text-[#5ba646] transition-colors">
            Contact Us
          </a>
        </h2>
      </div>

      <div class="md:col-span-4 text-left md:text-right">
        <h4>Follow Us</h4>
        <nav class="social mt-2 flex items-center md:justify-end">
          <a href="https://www.linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.78a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24"/></svg>
          </a>
          <a href="https://www.youtube.com" target="_blank" rel="noopener" aria-label="YouTube">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/></svg>
          </a>
          <a href="https://www.facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02Z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </nav>
      </div>
    </div>

  </div>

  <!-- Bottom Grey Bar (Matching ASGC ft-btm-sc) -->
  <div class="ft-btm-sc">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
        <div>
          <p>© {currentYear} Urbanspire Group Holdings. All rights reserved.</p>
          <p class="text-[11px] opacity-75 mt-0.5">
            Demonstration prototype: Subsidiary data and project records are architectural concepts per brief.
          </p>
        </div>

        <ul class="flex items-center space-x-6 text-xs">
          <li><a href="/about" class="hover:underline">Cookies</a></li>
          <li><a href="/contact" class="hover:underline">Terms and Conditions</a></li>
          <li><a href="/about" class="hover:underline">Accessibility</a></li>
        </ul>

        <div>
          <span class="opacity-75">by </span>
          <span class="font-medium text-white">Urbanspire Engineering</span>
        </div>
      </div>
    </div>
  </div>
</footer>
