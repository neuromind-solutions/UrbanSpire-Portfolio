---
const metrics = [
  {
    number: '3',
    suffix: 'Companies',
    label: 'Specialized Subsidiaries',
    subtext: 'Civil, General Contracting & MEP'
  },
  {
    number: '2.4M',
    suffix: 'm²',
    label: 'Delivered Floor Area',
    subtext: 'Commercial, Residential & Civic'
  },
  {
    number: '18+',
    suffix: 'Years',
    label: 'Group Legacy (Demo)',
    subtext: 'Engineering Landmark Skylines'
  },
  {
    number: 'Zero',
    suffix: 'Harm',
    label: 'QHSE Safety Commitment',
    subtext: 'Rigorous International Standards'
  }
];
---

<section class="relative z-20 -mt-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Group Key Metrics">
  <div class="bg-gradient-to-r from-[#141413] via-[#1c1c1a] to-[#141413] border border-white/10 rounded-sm shadow-2xl p-8 backdrop-blur-xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-white/10">
      {metrics.map((metric, idx) => (
        <div class={`flex flex-col ${idx !== 0 ? 'pt-6 md:pt-0 md:pl-8' : ''}`}>
          <div class="flex items-baseline gap-1.5 mb-2">
            <span class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              {metric.number}
            </span>
            <span class="font-display font-bold text-lg text-urbanspire-orange">
              {metric.suffix}
            </span>
          </div>
          <h3 class="text-sm font-semibold text-urbanspire-light tracking-wide">
            {metric.label}
          </h3>
          <p class="text-xs text-urbanspire-muted mt-1">
            {metric.subtext}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
