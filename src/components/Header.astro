---
const currentPath = Astro.url.pathname;

const navItems = [
  {
    name: 'About Us',
    href: '/about',
    submenu: [
      { name: 'Urbanspire in Brief', href: '/about' },
      { name: 'Group Heritage', href: '/about#heritage' },
      { name: 'Vision & Values', href: '/about#vision' },
      { name: 'Quality & HSE Standards', href: '/about#standards' },
    ]
  },
  {
    name: 'Our Companies',
    href: '/companies',
    submenu: [
      { name: 'Urbanspire Construction, Pune', href: '/companies/urbanspire-construction-pune' },
      { name: 'Urbanspire Marine, Mumbai', href: '/companies/urbanspire-marine-mumbai' },
      { name: 'Urbanspire Global Service, Dubai', href: '/companies/urbanspire-global-service-dubai' },
    ]
  },
  {
    name: 'Projects',
    href: '/projects',
  },
  {
    name: 'Services',
    href: '/services',
  },
  {
    name: 'How We Work',
    href: '/about#how-we-work',
    submenu: [
      { name: 'Quality Governance', href: '/services#quality' },
      { name: 'QHSE Safety & Zero Harm', href: '/about#safety' },
      { name: 'BIM & Digital Technology', href: '/services#bim' },
    ]
  },
  {
    name: 'Sustainability',
    href: '/about#sustainability',
  },
  {
    name: 'Careers',
    href: '/careers',
  },
  {
    name: 'Contact',
    href: '/contact',
  },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href.split('#')[0]) && href.split('#')[0] !== '/') return true;
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-gray-100">
  <nav
    class="navbar navbar-expand-lg center-nav asch-hd nav-solid px-4 md:px-8 w-full flex items-center justify-between"
    id="site-header"
  >
    <div class="max-w-7xl mx-auto w-full flex items-center justify-between py-1.5">
      
      <!-- Brand Logo: Official Urbanspire Group Logo -->
      <div class="navbar-brand">
        <a href="/" class="flex items-center group">
          <img
            src="/images/logo-transparent.png"
            alt="Urbanspire Group"
            class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]"
            loading="eager"
          />
        </a>
      </div>

      <!-- Desktop Navigation Menu -->
      <div class="hidden lg:flex items-center space-x-0.5 xl:space-x-1">
        <ul class="navbar-nav flex items-center flex-row space-x-0.5 xl:space-x-1">
          {navItems.map((item) => (
            <li class="nav-item relative group">
              <a
                href={item.href}
                class={`nav-link text-xs xl:text-sm px-2.5 xl:px-3.5 py-2 font-normal flex items-center gap-1 transition-colors whitespace-nowrap ${
                  isActive(item.href)
                    ? 'text-[#5ba646] font-medium'
                    : 'text-[#343f52] hover:text-[#5ba646]'
                }`}
              >
                <span>{item.name}</span>
                {item.submenu && (
                  <svg class="w-3 h-3 xl:w-3.5 xl:h-3.5 opacity-70 group-hover:opacity-100 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              <!-- Dropdown Menu -->
              {item.submenu && (
                <ul class="dropdown-menu absolute top-full left-0 hidden group-hover:block bg-white shadow-xl rounded-sm py-2 min-w-[230px] border border-gray-100 animate-fadeIn z-50">
                  {item.submenu.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="dropdown-item block px-4 py-2 text-xs font-normal text-[#343f52] hover:text-[#5ba646] hover:bg-gray-50 transition-colors"
                      >
                        {sub.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Header Actions -->
      <div class="navbar-other flex items-center space-x-3 sm:space-x-4">
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center justify-center px-4 xl:px-5 py-2 text-xs uppercase font-medium rounded-full transition-colors tracking-wider text-white bg-[#5ba646] hover:bg-[#18355f] shadow-sm whitespace-nowrap"
        >
          <span>Get in Touch</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          type="button"
          id="navbar-hamburger-btn"
          class="lg:hidden p-2 rounded-md focus:outline-none text-[#18355f] hover:text-[#5ba646] hover:bg-gray-100/80 transition-colors"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </nav>
</header>

<!-- Mobile Navigation Menu - Fullscreen Overlay (Outside <header> to use full height and width without backdrop-filter traps) -->
<div
  id="mobile-menu"
  class="fixed inset-0 w-full h-[100dvh] min-h-[100dvh] bg-[#18355f] text-white z-[99999] flex flex-col justify-between overflow-hidden opacity-0 pointer-events-none -translate-y-4 invisible transition-all duration-300 ease-in-out lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <!-- Top Bar: Logo Left, Properly Aligned Close Button Right -->
  <div class="h-16 px-5 sm:px-8 border-b border-white/15 flex items-center justify-between shrink-0 bg-[#122847]/90 backdrop-blur-md">
    <a href="/" class="flex items-center" id="mobile-logo-link">
      <img
        src="/images/logo-white.png"
        alt="Urbanspire Group"
        class="h-8 sm:h-9 w-auto object-contain"
      />
    </a>
    <button
      type="button"
      id="mobile-close-btn"
      class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 active:bg-[#5ba646] text-white flex items-center justify-center transition-all focus:outline-none focus:ring-2 focus:ring-[#5ba646]"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Scrollable Menu Items Area: Well-Spaced & Clearly Visible -->
  <div class="flex-1 overflow-y-auto px-5 sm:px-8 py-6 space-y-1">
    <nav class="space-y-1">
      {navItems.map((item, idx) => (
        <div class="border-b border-white/10 last:border-b-0 py-1">
          {item.submenu ? (
            <div>
              <div class="flex items-center justify-between py-2.5">
                <a
                  href={item.href}
                  class={`text-base sm:text-lg font-medium tracking-wide transition-colors ${
                    isActive(item.href) ? 'text-[#5ba646]' : 'text-white hover:text-[#5ba646]'
                  }`}
                >
                  {item.name}
                </a>
                <button
                  type="button"
                  class="mobile-submenu-btn p-2 -mr-2 text-white/70 hover:text-white transition-transform focus:outline-none"
                  data-target={`mobile-submenu-${idx}`}
                  aria-expanded="false"
                  aria-label={`Toggle ${item.name} submenu`}
                >
                  <svg class="w-5 h-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
              <ul id={`mobile-submenu-${idx}`} class="mobile-submenu-list hidden pl-4 pb-3 space-y-2 border-l-2 border-[#5ba646]/70 ml-1 mt-0.5">
                {item.submenu.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="block py-1 text-sm text-white/80 hover:text-[#5ba646] transition-colors"
                    >
                      {sub.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              class={`block py-3 text-base sm:text-lg font-medium tracking-wide transition-colors ${
                isActive(item.href) ? 'text-[#5ba646]' : 'text-white hover:text-[#5ba646]'
              }`}
            >
              {item.name}
            </a>
          )}
        </div>
      ))}
    </nav>
  </div>

  <!-- Bottom Action Bar / Corporate Links -->
  <div class="shrink-0 p-5 sm:px-8 py-5 border-t border-white/15 bg-[#122847]/95 space-y-3.5">
    <a
      href="/contact"
      id="mobile-contact-cta"
      class="w-full py-3.5 px-6 bg-[#5ba646] hover:bg-[#4d8f3b] text-white font-semibold text-center text-xs sm:text-sm uppercase tracking-wider rounded-lg shadow-lg transition-all flex items-center justify-center gap-2"
    >
      <span>Get in Touch</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    
    <div class="flex items-center justify-between text-xs text-white/60 pt-1">
      <span>Pune • Mumbai • Dubai</span>
      <a href="mailto:info@urbanspiregroup.com" class="hover:text-[#5ba646] transition-colors">
        info@urbanspiregroup.com
      </a>
    </div>
  </div>
</div>

<script>
  function setupMobileNavigation() {
    const hamburger = document.getElementById('navbar-hamburger-btn');
    const menu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('mobile-close-btn');
    const submenuBtns = document.querySelectorAll<HTMLButtonElement>('.mobile-submenu-btn');
    const menuLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');

    function openMobileMenu() {
      if (!menu) return;
      menu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4', 'invisible');
      menu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'visible');
      hamburger?.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      if (!menu) return;
      menu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4', 'invisible');
      menu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'visible');
      hamburger?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    hamburger?.addEventListener('click', openMobileMenu);
    closeBtn?.addEventListener('click', closeMobileMenu);

    // Submenu accordion toggles
    submenuBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const subList = document.getElementById(targetId);
        const icon = btn.querySelector('svg');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (subList) {
          if (isExpanded) {
            subList.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            icon?.classList.remove('rotate-180');
          } else {
            subList.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            icon?.classList.add('rotate-180');
          }
        }
      });
    });

    // Close when clicking any navigation link
    menuLinks.forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileMenu();
    });

    // Automatically close on desktop resize
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) {
        closeMobileMenu();
      }
    });
  }

  // Initialize immediately and on view transitions if any
  setupMobileNavigation();
  document.addEventListener('astro:page-load', setupMobileNavigation);
</script>
